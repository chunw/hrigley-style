# Public — bundled into the browser JS (Vite only exposes vars prefixed with VITE_).
# This is your PayPal app's Client ID, safe to expose.
VITE_PAYPAL_CLIENT_ID=

# Server-only — used by the /api/paypal/* functions, never sent to the browser.
# Set the real values in Vercel Project Settings > Environment Variables, not here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" (default, for testing) or "live" (real payments)
PAYPAL_ENV=sandbox
